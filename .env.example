# Configuration reference with empty placeholders. The demo preview needs no credentials.
# A real Twitch rehearsal needs Proton-injected Twitch and encryption credentials.
# For live operation use docs/*.env.tmpl with Proton Pass; see the deployment runbook.
# Do not paste or print secret values, or create a secret-bearing .env file.
PORT=3000
HOST=127.0.0.1
PUBLIC_URL=http://localhost:3000
NODE_ENV=development
ENABLE_DEMO=true
# Confidential Twitch application. Register EXACT callback PUBLIC_URL/auth/twitch/callback.
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
# Generate and keep this key in Proton Pass; inject it only into the server process.
# Required for Twitch. 64 hex characters; encrypts OAuth tokens on disk.
TOKEN_ENCRYPTION_KEY=
# Local Moonshine is the default and needs no speech-provider key.
SPEECH_PROVIDER=moonshine
# Only required with SPEECH_PROVIDER=deepgram. Server only; provider charges may apply.
DEEPGRAM_API_KEY=
# Native Twitch Extension. Its client ID is public; its base64 shared key is server-only.
TWITCH_EXTENSION_CLIENT_ID=
TWITCH_EXTENSION_SECRET=
# Exact extra frontend origins. The Extension's Twitch CDN origin is added automatically.
EXTENSION_ALLOWED_ORIGINS=https://localhost:3443
DATA_DIR=./data

# Optional comma-separated IP/CIDR allowlist for your actual reverse proxy.
# Keep empty for direct access. Never use public client ranges or a hop count.
TRUSTED_PROXIES=
