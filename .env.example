# Configuration reference with empty placeholders. Local rehearsal needs no credentials.
# For live operation use docs/*.env.tmpl with Proton Pass; see the deployment runbook.
# Do not paste or print secret values, or create a secret-bearing .env file.
PORT=3000
HOST=127.0.0.1
PUBLIC_URL=http://localhost:3000
NODE_ENV=development
ENABLE_DEMO=true
# Confidential Twitch application. Register EXACT callback PUBLIC_URL/auth/twitch/callback.
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
# Generate and keep this key in Proton Pass; inject it only into the server process.
# Required for Twitch. 64 hex characters; encrypts OAuth tokens on disk.
TOKEN_ENCRYPTION_KEY=
# Server only. Streaming speech can incur provider charges; BAIT has no payment features.
DEEPGRAM_API_KEY=
DATA_DIR=./data

# Optional comma-separated IP/CIDR allowlist for your actual reverse proxy.
# Keep empty for direct access. Never use public client ranges or a hop count.
TRUSTED_PROXIES=
