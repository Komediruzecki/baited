# Copy to .env. Local rehearsal runs without credentials. Never commit .env.
PORT=3000
HOST=127.0.0.1
PUBLIC_URL=http://localhost:3000
NODE_ENV=development
ENABLE_DEMO=true
# Confidential Twitch application. Register EXACT callback PUBLIC_URL/auth/twitch/callback.
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Required for Twitch. 64 hex characters; encrypts OAuth tokens on disk.
TOKEN_ENCRYPTION_KEY=
# Server only. Streaming speech can incur provider charges; BAIT has no payment features.
DEEPGRAM_API_KEY=
DATA_DIR=./data
