{
  "name": "bait-twitch",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "BAIT: chat gets a secret word and tries to make the streamer say it.",
  "engines": {
    "node": ">=22.12"
  },
  "packageManager": "pnpm@10.7.1",
  "scripts": {
    "dev": "tsx watch server/index.ts",
    "build": "tsc --noEmit && vite build && tsup server/index.ts --format esm --platform node --target node22 --out-dir dist/server --external vite",
    "start": "node --env-file-if-exists=.env dist/server/index.js --static",
    "test": "tsx --test tests/*.test.ts",
    "check": "tsc --noEmit",
    "licenses": "node scripts/licenses.mjs"
  },
  "dependencies": {
    "express": "^5.1.0",
    "helmet": "^8.1.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "ws": "^8.18.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/ws": "^8.5.13",
    "@vitejs/plugin-react": "^4.3.4",
    "tsup": "^8.3.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite": "^6.0.0"
  }
}
