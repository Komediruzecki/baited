{
  "name": "baited",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.3",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "pnpm --filter @baited/app dev",
    "start": "pnpm --filter @baited/app start",
    "dev:landing": "pnpm --filter @baited/landing dev",
    "preview:local": "pnpm --filter @baited/app preview:local",
    "preview:extension": "pnpm --filter @baited/app preview:extension",
    "extension:local": "pnpm --filter @baited/app extension:local",
    "rehearsal:local": "pnpm --filter @baited/app rehearsal:local",
    "check": "pnpm -r check",
    "test": "pnpm --filter @baited/app test && pnpm --filter @baited/landing test:run && pnpm --filter @irchiinnuss/review-host test:run && pnpm --filter @baited/edge-game test",
    "build": "pnpm --filter @baited/app build && pnpm --filter @baited/landing deploy:dry-run",
    "build:extension": "pnpm --filter @baited/app build:extension",
    "check:landing": "pnpm --filter @baited/landing check && pnpm --filter @baited/landing test:run && pnpm --filter @baited/landing deploy:dry-run && pnpm --filter @baited/landing deploy:dry-run:prod",
    "dev:edge:local": "pnpm --filter @baited/edge-game dev:local",
    "build:edge": "pnpm --filter @baited/edge-game build"
  }
}
