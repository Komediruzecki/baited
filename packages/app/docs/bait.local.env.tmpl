# Reference-only template. Replace vault/item placeholders with existing Proton Pass references.
# Never replace these references with secret values. Start with pass-cli run --env-file.
# These placeholder paths do not identify existing vault entries.
PORT=3000
HOST=127.0.0.1
PUBLIC_URL=http://localhost:3000
NODE_ENV=development
ENABLE_DEMO=true
DATA_DIR=./data
TWITCH_CLIENT_ID=pass://REPLACE_VAULT/REPLACE_TWITCH_ITEM/client_id
TWITCH_CLIENT_SECRET=pass://REPLACE_VAULT/REPLACE_TWITCH_ITEM/client_secret
TOKEN_ENCRYPTION_KEY=pass://REPLACE_VAULT/REPLACE_BAIT_ITEM/token_encryption_key
# Optional chat bot: the bot account's numeric Twitch user ID. Not a secret. See docs/chat-bot.md.
# TWITCH_BOT_USER_ID=
# Only when the streamer's own account is also the bot account. Otherwise leave it unset.
# TWITCH_BOT_IS_STREAMER=1
# Moonshine runs locally and needs no speech-provider key.
SPEECH_PROVIDER=moonshine
# To choose Deepgram, set SPEECH_PROVIDER=deepgram and uncomment its reference.
# DEEPGRAM_API_KEY=pass://REPLACE_VAULT/REPLACE_SPEECH_ITEM/api_key
