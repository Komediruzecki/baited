# GENERIC REFERENCE ONLY. For this PC's Hosted Test use baited.hosted-backend.env.tmpl
# with ops/hosted-test.mjs and follow HOSTED_TEST.md instead.
# Replace non-secret host/path/proxy values and pass:// references before approved deployment.
NODE_ENV=production
ENABLE_DEMO=false
HOST=127.0.0.1
PORT=3000
PUBLIC_URL=https://REPLACE_OWNED_DOMAIN.example
DATA_DIR=/REPLACE_PERSISTENT_PRIVATE_PATH/bait
# Empty means direct peers only. Add only actual trusted immediate proxy IPs/CIDRs.
TRUSTED_PROXIES=
TWITCH_CLIENT_ID=pass://REPLACE_VAULT/REPLACE_TWITCH_ITEM/client_id
TWITCH_CLIENT_SECRET=pass://REPLACE_VAULT/REPLACE_TWITCH_ITEM/client_secret
TOKEN_ENCRYPTION_KEY=pass://REPLACE_VAULT/REPLACE_BAIT_ITEM/token_encryption_key
TWITCH_EXTENSION_CLIENT_ID=pass://REPLACE_VAULT/REPLACE_TWITCH_ITEM/extension_client_id
TWITCH_EXTENSION_SECRET=pass://REPLACE_VAULT/REPLACE_TWITCH_ITEM/extension_shared_secret
SPEECH_PROVIDER=moonshine
# Optional chat bot: the bot account's numeric Twitch user ID. Not a secret. See docs/chat-bot.md.
# TWITCH_BOT_USER_ID=
# Only when the streamer's own account is also the bot account. Otherwise leave it unset.
# TWITCH_BOT_IS_STREAMER=1
