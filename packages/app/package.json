{
  "name": "@baited/app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Baited: chat gets a secret word and tries to make the streamer say it.",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "tsx watch server/index.ts",
    "build": "tsx scripts/build-review-catalogue.ts --check && tsc --noEmit && vite build && tsup server/index.ts --format esm --platform node --target node22 --out-dir dist/server --external vite && node scripts/copy-card-art-runtime.mjs",
    "start": "node --env-file-if-exists=.env dist/server/index.js --static",
    "preview:local": "node scripts/preview-local.mjs",
    "preview:concept": "node scripts/preview-concept.mjs",
    "catalogue:review": "tsx scripts/build-review-catalogue.ts",
    "rehearsal:local": "node scripts/rehearse-local.mjs",
    "test": "tsx --test tests/*.test.ts extension/tests/*.test.js",
    "check": "tsc --noEmit",
    "licenses": "node scripts/licenses.mjs",
    "build:extension": "node scripts/build-extension.mjs",
    "preview:extension": "node scripts/preview-extension.mjs",
    "extension:local": "node scripts/serve-extension-local.mjs",
    "bot:transcript": "tsx scripts/bot-transcript.ts"
  },
  "dependencies": {
    "@moonshine-ai/moonshine-wasm": "0.1.5",
    "@tensorflow/tfjs": "^4.22.0",
    "@tensorflow/tfjs-backend-wasm": "^4.22.0",
    "express": "^5.1.0",
    "helmet": "^8.1.0",
    "jose": "^6",
    "nsfwjs": "4.4.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sharp": "0.35.2",
    "ws": "^8.18.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/ws": "^8.5.13",
    "@vitejs/plugin-react": "^4.3.4",
    "tsup": "^8.3.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite": "^6.0.0"
  }
}
